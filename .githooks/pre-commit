#!/usr/bin/env bash
# zzb — secret-scan pre-commit hook (git-hook based; replaces the CI workflow).
# Blocks a commit that would introduce a credential OR an internal reference.
# Enable once per clone:   git config core.hooksPath .githooks
set -uo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$staged" ] && exit 0

fail=0

# 1) Credentials: gitleaks (same engine as the release gate) when available.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner --redact; then
        echo "[x] gitleaks found a secret in staged changes." >&2
        echo "    Remove it, or (if a verified false positive) add a rule to .gitleaksignore." >&2
        fail=1
    fi
fi

# 2) ALWAYS: an internal-reference + obvious-credential regex. gitleaks does NOT
#    flag internal paths / @ab0t.com emails, but a public repo must never carry
#    them — this mirrors release.sh's default-deny backstop, so it runs whether
#    or not gitleaks is installed.
pat='ab0t_sk_(live|test)|BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]+|/home/[a-z][a-z0-9_-]*/|@ab0t\.com'
if git diff --cached -U0 --diff-filter=ACM -- . ':(exclude).githooks/*' | grep -nEi "$pat" >&2; then
    echo "[x] a potential secret / internal reference (above) is staged." >&2
    echo "    Remove the match before committing." >&2
    fail=1
fi

[ "$fail" -eq 0 ] || { echo "[x] commit blocked by secret-scan hook." >&2; exit 1; }
exit 0
