#!/usr/bin/env bash
# zzb — secret-scan pre-push backstop (git-hook based). Publishing is the
# irreversible step, so scan the whole tree once more before it leaves.
# Enable once per clone:   git config core.hooksPath .githooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
fail=0

if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks dir --no-banner --redact "$root"; then
        echo "[x] gitleaks found a secret in the tree." >&2
        fail=1
    fi
else
    echo "[!] gitleaks not installed — install it for the strongest pre-push scan." >&2
fi

# Internal-reference backstop over tracked files (gitleaks misses these).
pat='/home/[a-z][a-z0-9_-]*/|@ab0t\.com|ab0t_sk_(live|test)'
if git grep -nEI "$pat" -- . ':(exclude).githooks/*' >&2; then
    echo "[x] an internal reference (above) is tracked — push blocked." >&2
    fail=1
fi

[ "$fail" -eq 0 ] || { echo "[x] push blocked by secret-scan hook." >&2; exit 1; }
exit 0
